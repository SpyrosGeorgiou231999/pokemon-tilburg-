diff --git a/data/maps/LittlerootTown/scripts.inc b/data/maps/LittlerootTown/scripts.inc
index 7009fbb..9fd0e35 100644
--- a/data/maps/LittlerootTown/scripts.inc
+++ b/data/maps/LittlerootTown/scripts.inc
@@ -1,4 +1,167 @@
 LittlerootTown_MapScripts::
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, Tilburg_OnFrame
+	.byte 0
+
+Tilburg_OnFrame:
+	map_script_2 VAR_UNUSED_0x404E, 0, Tilburg_EventScript_Welcome
+	.2byte 0
+
+@ ---------------------------------------------------------------- the welcome: Salt hands you your team
+Tilburg_EventScript_Welcome::
+	lockall
+	msgbox Tilburg_Text_Welcome, MSGBOX_DEFAULT
+	givemon SPECIES_BLAZIKEN, 33
+	givemon SPECIES_GARDEVOIR, 32
+	givemon SPECIES_FLYGON, 32
+	givemon SPECIES_AGGRON, 32
+	givemon SPECIES_MANECTRIC, 32
+	givemon SPECIES_MILOTIC, 32
+	setflag FLAG_SYS_POKEMON_GET
+	setflag FLAG_SYS_B_DASH
+	additem ITEM_HYPER_POTION, 10
+	additem ITEM_REVIVE, 5
+	playfanfare MUS_OBTAIN_ITEM
+	message Tilburg_Text_GotTeam
+	waitmessage
+	waitfanfare
+	msgbox Tilburg_Text_Welcome2, MSGBOX_DEFAULT
+	setvar VAR_UNUSED_0x404E, 1
+	releaseall
+	end
+
+@ ---------------------------------------------------------------- the cast
+Tilburg_EventScript_Salt::
+	trainerbattle_single TRAINER_TILBURG_SALT, Tilburg_Text_SaltIntro, Tilburg_Text_SaltDefeat
+	msgbox Tilburg_Text_SaltAfter, MSGBOX_AUTOCLOSE
+	end
+
+Tilburg_EventScript_Hlias::
+	trainerbattle_single TRAINER_TILBURG_HLIAS, Tilburg_Text_HliasIntro, Tilburg_Text_HliasDefeat
+	msgbox Tilburg_Text_HliasAfter, MSGBOX_AUTOCLOSE
+	end
+
+Tilburg_EventScript_Mert::
+	trainerbattle_single TRAINER_TILBURG_MERT, Tilburg_Text_MertIntro, Tilburg_Text_MertDefeat
+	msgbox Tilburg_Text_MertAfter, MSGBOX_AUTOCLOSE
+	end
+
+Tilburg_EventScript_Night::
+	trainerbattle_single TRAINER_TILBURG_NIGHT, Tilburg_Text_NightIntro, Tilburg_Text_NightDefeat
+	msgbox Tilburg_Text_NightAfter, MSGBOX_AUTOCLOSE
+	end
+
+Tilburg_EventScript_Lev::
+	trainerbattle_single TRAINER_TILBURG_LEV, Tilburg_Text_LevIntro, Tilburg_Text_LevDefeat
+	msgbox Tilburg_Text_LevAfter, MSGBOX_AUTOCLOSE
+	end
+
+Tilburg_EventScript_Mehmed::
+	trainerbattle_single TRAINER_TILBURG_MEHMED, Tilburg_Text_MehmedIntro, Tilburg_Text_MehmedDefeat
+	msgbox Tilburg_Text_MehmedAfter, MSGBOX_AUTOCLOSE
+	end
+
+@ ---------------------------------------------------------------- text
+Tilburg_Text_Welcome:
+	.string "SALT: yo. good evening gamer.\p"
+	.string "Welcome to TILBURG. This is the\n"
+	.string "BALKANS IRL server.\p"
+	.string "Everyone here will want to battle you.\n"
+	.string "You can't show up with no team, so\l"
+	.string "here. Take these.$"
+
+Tilburg_Text_GotTeam:
+	.string "{PLAYER} received a team\n"
+	.string "of six POKéMON!$"
+
+Tilburg_Text_Welcome2:
+	.string "SALT: HLIAS, MERT, NIGHT, LEV and\n"
+	.string "MEHMED are around town.\p"
+	.string "Beat them all, then come find me.\n"
+	.string "1.17 rating. Verified.$"
+
+Tilburg_Text_TownSign:
+	.string "TILBURG\n"
+	.string "Home of the BALKANS IRL server.$"
+
+Tilburg_Text_SaltIntro:
+	.string "SALT: You beat everyone? Good.\p"
+	.string "Now face the owner.\n"
+	.string "Salt super saiyan will activate.$"
+
+Tilburg_Text_SaltDefeat:
+	.string "1.17 rating and you still won.\n"
+	.string "gg.$"
+
+Tilburg_Text_SaltAfter:
+	.string "SALT: drip check passed.\n"
+	.string "You can stay in the server.$"
+
+Tilburg_Text_HliasIntro:
+	.string "HLIAS: GAH DAMN, a new member!\p"
+	.string "You look like you need some\n"
+	.string "boxing lessons, bro.$"
+
+Tilburg_Text_HliasDefeat:
+	.string "bro legit the most insane\n"
+	.string "shi I've ever seen.$"
+
+Tilburg_Text_HliasAfter:
+	.string "HLIAS: Kigali is so clean you can\n"
+	.string "eat on the road floor.\p"
+	.string "One day I take you there.$"
+
+Tilburg_Text_MertIntro:
+	.string "MERT: bro I was winning before\n"
+	.string "you even got here.$"
+
+Tilburg_Text_MertDefeat:
+	.string "I was winning.\n"
+	.string "This one does not count.$"
+
+Tilburg_Text_MertAfter:
+	.string "MERT: My cousin says losing is a\n"
+	.string "sign. A sign to bet more.$"
+
+Tilburg_Text_NightIntro:
+	.string "NIGHT: I haven't said a single word\n"
+	.string "but I already know where this\l"
+	.string "is going.$"
+
+Tilburg_Text_NightDefeat:
+	.string "Natural selection failed\n"
+	.string "me today.$"
+
+Tilburg_Text_NightAfter:
+	.string "NIGHT: Big brother is watching.\n"
+	.string "Mostly it is me.$"
+
+Tilburg_Text_LevIntro:
+	.string "LEV: As archbishop of the\n"
+	.string "BALKANS IRL orthodox church,\l"
+	.string "I challenge you.$"
+
+Tilburg_Text_LevDefeat:
+	.string "We are never making it out\n"
+	.string "of ignorance.$"
+
+Tilburg_Text_LevAfter:
+	.string "LEV: The means of production\n"
+	.string "belong to the trainers.$"
+
+Tilburg_Text_MehmedIntro:
+	.string "MEHMED: ong.$"
+
+Tilburg_Text_MehmedDefeat:
+	.string "ong.$"
+
+Tilburg_Text_MehmedAfter:
+	.string "MEHMED: hollon gang.$"
+
+LittlerootTown_Text_TownSign:
+	.string "TILBURG\n"
+	.string "Home of the BALKANS IRL server.$"
+
+LittlerootTown_MapScripts_Original::
 	map_script MAP_SCRIPT_ON_TRANSITION, LittlerootTown_OnTransition
 	map_script MAP_SCRIPT_ON_FRAME_TABLE, LittlerootTown_OnFrame
 	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, LittlerootTown_OnWarp
@@ -936,7 +1099,7 @@ LittlerootTown_Text_GoodLuckCatchingPokemon:
 	.string "Are you going to catch POKéMON?\n"
 	.string "Good luck!$"
 
-LittlerootTown_Text_TownSign:
+LittlerootTown_Text_TownSign_Original:
 	.string "LITTLEROOT TOWN\n"
 	.string "“A town that can't be shaded any hue.”$"
 
