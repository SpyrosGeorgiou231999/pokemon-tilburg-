+TheServer_RematchRoom_MapScripts::
+	.byte 0
+
+TheServer_RematchRoom_EventScript_Heal::
+	lock
+	faceplayer
+	msgbox TheServer_RematchRoom_Text_Heal, MSGBOX_DEFAULT
+	special HealPlayerParty
+	playfanfare MUS_HEAL
+	waitfanfare
+	release
+	end
+
+TheServer_RematchRoom_Text_Heal:
+	.string "Everyone in the server is here.\n"
+	.string "Let me heal your team first.$"
+
+TheServer_RematchRoom_EventScript_Hlias::
+	cleartrainerflag TRAINER_BRENDAN_PLACEHOLDER
+	trainerbattle_single TRAINER_BRENDAN_PLACEHOLDER, TheServer_RematchRoom_Text_HliasIntro, TheServer_RematchRoom_Text_HliasDefeat
+	msgbox TheServer_RematchRoom_Text_HliasDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_HliasIntro:
+	.string "HLIAS: I've been training since\nISTANBUL. Hajime no Ippo style.\pRematch. Right now.$"
+
+TheServer_RematchRoom_Text_HliasDefeat:
+	.string "GAH. Fine. I'll be back.$"
+
+TheServer_RematchRoom_EventScript_Mert::
+	cleartrainerflag TRAINER_WALLY_VR_5
+	trainerbattle_single TRAINER_WALLY_VR_5, TheServer_RematchRoom_Text_MertIntro, TheServer_RematchRoom_Text_MertDefeat
+	msgbox TheServer_RematchRoom_Text_MertDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_MertIntro:
+	.string "MERT: Best of seven? Best of three.\nOk one. One game.$"
+
+TheServer_RematchRoom_Text_MertDefeat:
+	.string "I was winning. On paper.$"
+
+TheServer_RematchRoom_EventScript_G::
+	cleartrainerflag TRAINER_ROXANNE_5
+	trainerbattle_single TRAINER_ROXANNE_5, TheServer_RematchRoom_Text_GIntro, TheServer_RematchRoom_Text_GDefeat
+	msgbox TheServer_RematchRoom_Text_GDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_GIntro:
+	.string "G140: I rebuilt the factory.\nIt's bigger now. Way bigger.$"
+
+TheServer_RematchRoom_Text_GDefeat:
+	.string "The factory needs more iron.$"
+
+TheServer_RematchRoom_EventScript_Kd::
+	cleartrainerflag TRAINER_BRAWLY_5
+	trainerbattle_single TRAINER_BRAWLY_5, TheServer_RematchRoom_Text_KdIntro, TheServer_RematchRoom_Text_KdDefeat
+	msgbox TheServer_RematchRoom_Text_KdDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_KdIntro:
+	.string "KD: Round two, bruh.$"
+
+TheServer_RematchRoom_Text_KdDefeat:
+	.string "bruh.$"
+
+TheServer_RematchRoom_EventScript_Yancar::
+	cleartrainerflag TRAINER_WATTSON_5
