+	msgbox TheServer_RematchRoom_Text_YancarDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_YancarIntro:
+	.string "YANCAR: The deepstate dug deeper.\nLook what we found.$"
+
+TheServer_RematchRoom_Text_YancarDefeat:
+	.string "Okay. You never saw this.$"
+
+TheServer_RematchRoom_EventScript_Mehmed::
