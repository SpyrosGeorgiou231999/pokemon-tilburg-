+	msgbox TheServer_RematchRoom_Text_CatDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_CatIntro:
+	.string "CAT: Your dad is back. Lowkey\nstronger than before.$"
+
+TheServer_RematchRoom_Text_CatDefeat:
+	.string "Ok. Back to CK3.$"
+
+TheServer_RematchRoom_EventScript_Peachy::
+	cleartrainerflag TRAINER_WINONA_5
+	trainerbattle_single TRAINER_WINONA_5, TheServer_RematchRoom_Text_PeachyIntro, TheServer_RematchRoom_Text_PeachyDefeat
+	msgbox TheServer_RematchRoom_Text_PeachyDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_PeachyIntro:
+	.string "PEACHY: I'm not in Amsterdam yet.\nSo. One more battle.$"
+
+TheServer_RematchRoom_Text_PeachyDefeat:
+	.string "Okay, that was actually insane.$"
+
+TheServer_RematchRoom_EventScript_LevGus::
+	cleartrainerflag TRAINER_TATE_AND_LIZA_5
+	trainerbattle_double TRAINER_TATE_AND_LIZA_5, TheServer_RematchRoom_Text_LevGusIntro, TheServer_RematchRoom_Text_LevGusDefeat, TheServer_RematchRoom_Text_NeedTwo
+	msgbox TheServer_RematchRoom_Text_LevGusDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_LevGusIntro:
+	.string "LEV: We have new sources.\pGUS: And I have easy mode on.$"
+
+TheServer_RematchRoom_Text_LevGusDefeat:
+	.string "LEV: Peak comedy. Again.$"
+
+TheServer_RematchRoom_EventScript_Ibis::
+	cleartrainerflag TRAINER_JUAN_5
+	trainerbattle_single TRAINER_JUAN_5, TheServer_RematchRoom_Text_IbisIntro, TheServer_RematchRoom_Text_IbisDefeat
+	msgbox TheServer_RematchRoom_Text_IbisDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_IbisIntro:
+	.string "IBIS: Group hug first. Then I\ndestroy you.$"
+
+TheServer_RematchRoom_Text_IbisDefeat:
+	.string "Mixed messages, I know.$"
+
+TheServer_RematchRoom_EventScript_Svizek::
+	cleartrainerflag TRAINER_TILBURG_SVIZEK
+	trainerbattle_single TRAINER_TILBURG_SVIZEK, TheServer_RematchRoom_Text_SvizekIntro, TheServer_RematchRoom_Text_SvizekDefeat
+	msgbox TheServer_RematchRoom_Text_SvizekDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_SvizekIntro:
+	.string "SVIZEK: We debate again.$"
+
+TheServer_RematchRoom_Text_SvizekDefeat:
+	.string "Period.$"
+
+TheServer_RematchRoom_EventScript_Edelherz::
+	cleartrainerflag TRAINER_TILBURG_EDELHERZ
+	trainerbattle_single TRAINER_TILBURG_EDELHERZ, TheServer_RematchRoom_Text_EdelherzIntro, TheServer_RematchRoom_Text_EdelherzDefeat
+	msgbox TheServer_RematchRoom_Text_EdelherzDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_EdelherzIntro:
+	.string "EDELHERZ: New account. Same me.$"
+
+TheServer_RematchRoom_Text_EdelherzDefeat:
+	.string "Deleted again.$"
+
+TheServer_RematchRoom_EventScript_Skros::
+	cleartrainerflag TRAINER_TILBURG_SKROS
+	trainerbattle_single TRAINER_TILBURG_SKROS, TheServer_RematchRoom_Text_SkrosIntro, TheServer_RematchRoom_Text_SkrosDefeat
+	msgbox TheServer_RematchRoom_Text_SkrosDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_SkrosIntro:
+	.string "SKROS: I bought a bigger ice\ncream container.$"
+
+TheServer_RematchRoom_Text_SkrosDefeat:
+	.string "Still melted.$"
+
+TheServer_RematchRoom_EventScript_Erminio::
+	cleartrainerflag TRAINER_TILBURG_ERMINIO
+	trainerbattle_single TRAINER_TILBURG_ERMINIO, TheServer_RematchRoom_Text_ErminioIntro, TheServer_RematchRoom_Text_ErminioDefeat
+	msgbox TheServer_RematchRoom_Text_ErminioDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_ErminioIntro:
+	.string "ERMINIO: Second round of funding.$"
+
+TheServer_RematchRoom_Text_ErminioDefeat:
+	.string "Bad quarter.$"
+
+TheServer_RematchRoom_EventScript_Salt::
+	cleartrainerflag TRAINER_TILBURG_SALT
+	trainerbattle_single TRAINER_TILBURG_SALT, TheServer_RematchRoom_Text_SaltIntro, TheServer_RematchRoom_Text_SaltDefeat
+	msgbox TheServer_RematchRoom_Text_SaltDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_SaltIntro:
+	.string "SALT: Owner rematch. This time\nI brought something from the sky.$"
+
+TheServer_RematchRoom_Text_SaltDefeat:
+	.string "gg. Peak, again.$"
+
+TheServer_RematchRoom_EventScript_Night::
+	cleartrainerflag TRAINER_TILBURG_NIGHT
+	trainerbattle_single TRAINER_TILBURG_NIGHT, TheServer_RematchRoom_Text_NightIntro, TheServer_RematchRoom_Text_NightDefeat
+	msgbox TheServer_RematchRoom_Text_NightDefeat, MSGBOX_AUTOCLOSE
+	end
+
+TheServer_RematchRoom_Text_NightIntro:
+	.string "NIGHT: I research, I don't battle.\nToday I make an exception.$"
+
+TheServer_RematchRoom_Text_NightDefeat:
+	.string "Interesting. Very interesting.$"
+
+TheServer_RematchRoom_EventScript_Flavi::
